# 生产环境变量清单（草案）
#
# 用法：复制到服务器 /etc/litubo/litubo.env，逐项填真实值，然后
#   sudo chown root:litubo /etc/litubo/litubo.env
#   sudo chmod 640 /etc/litubo/litubo.env
#
# 这个文件只进仓库"键名与说明"，**永远不要**把真实值写进仓库。
# 不要在这个文件里使用密码登录方式：服务器访问用 SSH key。

# ── 必填 ─────────────────────────────────────────────────────────
# 公开站点地址（决定 canonical / OG / sitemap 里的域名）
NUXT_PUBLIC_SITE_URL=https://litubo.com

# 生产必须是 directus：写成 fixtures 会让站点显示演示数据
CMS_MODE=directus
CMS_MODE_PRODUCTS=directus

# Directus 服务地址（生产上通常是容器或本机端口）
DIRECTUS_URL=http://127.0.0.1:8055

# 服务端只读令牌（Directus 里 site-readonly-policy 对应角色）
DIRECTUS_TOKEN=__REPLACE_WITH_SERVICE_TOKEN__

# 管理员登录用（后台登录，不参与公开读取）
DIRECTUS_ADMIN_EMAIL=__REPLACE__
DIRECTUS_ADMIN_PASSWORD=__REPLACE__

# 访客/询盘限流用的 HMAC 密钥（随机 32+ 字节，勿复用）
SUBMISSION_IP_SECRET=__REPLACE_WITH_RANDOM_SECRET__

# ── 可选：邮件通知（不配只影响通知，不影响询盘入库）────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=info@litubo.com
SALES_EMAIL=sales@litubo.com

# ── 可选：后台 AI（不配则后台显示 AI 不可用，人工流程照常）──────
AI_DEFAULT_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# ── 可选：其他 ───────────────────────────────────────────────────
DIRECTUS_UPLOADS_DIR=/srv/litubo/uploads
PRIVACY_POLICY_VERSION=2026-01
