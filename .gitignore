# Environment
.env
.env.*
!.env.example

# Nuxt build
.nuxt/
.output/
dist/
.cache/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Local form submissions (development only)
.data/

# Local CMS data volumes (bind mounts — never commit)
dev-data/

# Local database backups (never commit)
backups/

# Temporary credential files (never commit)
/jwt.txt
*.token.txt

# Private product source materials (local only, never commit)
/private-product-source/

# Logs
*.log
npm-debug.log*

# Type declarations (generated)
*.d.ts
!types/**/*.d.ts

# 备份里永远不提交凭据与客户个人信息
backup/**/*.sql
backup/**/inquiries.json
backup/**/visitor_events.json
backup/**/_media_index.json
backup/**/uploads/

