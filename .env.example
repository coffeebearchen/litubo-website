# ─── Site ──────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://litubo.com

# ─── Form email recipients (set in production) ─────────────────────────
CONTACT_EMAIL=info@litubo.com
SALES_EMAIL=sales@litubo.com

# ─── SMTP (required for live email delivery; leave empty in development) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@litubo.com

# ─── Docker Compose — CMS data directories ─────────────────────────────
# Local (Windows Docker Desktop): use relative paths
# Production (Linux):             use absolute paths, e.g. /data/litubo/postgres
POSTGRES_DATA_DIR=./dev-data/postgres
DIRECTUS_UPLOADS_DIR=./dev-data/uploads

# ─── PostgreSQL ─────────────────────────────────────────────────────────
DB_DATABASE=litubo_cms
DB_USER=litubo
DB_PASSWORD=<generate-strong-password-min-16-chars>

# ─── Directus ───────────────────────────────────────────────────────────
DIRECTUS_SECRET=<generate-random-string-min-32-chars>
DIRECTUS_ADMIN_EMAIL=<admin-email-address>
DIRECTUS_ADMIN_PASSWORD=<initial-password-change-immediately-after-first-login>
# Local dev:   http://localhost:8055
# Production:  http://localhost:8055  (SSH tunnel only — no public domain)
DIRECTUS_PUBLIC_URL=http://localhost:8055

# ─── Nuxt server adapter → Directus (used from Phase 3 onwards) ─────────
# Local Nuxt dev server connects to Directus at:  http://localhost:8055
# Production Nuxt → Directus network TBD when Nuxt deploy method is confirmed
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=<site-readonly token — generate in Directus Admin → Settings → Roles → site-readonly → user token>
# fixtures = use local fixture data; directus = fetch from Directus CMS
CMS_MODE=fixtures

# ─── Inquiry security (Phase 6+) ────────────────────────────────────────
# HMAC-SHA256 key used to hash client IPs for in-process rate limiting.
# Value never stored in database. Generate with: openssl rand -hex 32
SUBMISSION_IP_SECRET=<generate-random-hex-min-32-chars>
# Stamp on every consent_given record. Increment when privacy policy changes.
PRIVACY_POLICY_VERSION=1.0

# ─── HubSpot Contact sync (Phase 7B — leave empty until HubSpot is configured) ─
# Leave empty in Phase 7A; fill in Phase 7B after creating a HubSpot Private App.
# Token requires scope: crm.objects.contacts.read, crm.objects.contacts.write
# When empty: all inquiries are saved with hubspot_sync_status=not_configured
HUBSPOT_ACCESS_TOKEN=
# Local mock testing only — overrides API base in non-production environments.
# Leave empty in production; the code always uses https://api.hubapi.com when NODE_ENV=production.
HUBSPOT_API_BASE_URL=

# ─── AI provider registry (PWS-AI-PLATFORM-01 + PWS-AI-PROVIDER-02; no Generate/Review/Apply UI yet) ─
# Server-side only — never exposed to the browser. Each provider is independently
# fail-closed: leave its two values empty and it reports "AI provider is not
# configured." No cost is incurred until a value is set AND a future authorized
# module explicitly calls that one provider — there is no automatic fallback
# between providers and a single request is never sent to more than one.
# Which already-configured provider a future Generate call defaults to. Only
# "deepseek" or "openai" are recognized; anything else (including empty) falls
# back to "deepseek". Never a secret.
AI_DEFAULT_PROVIDER=deepseek

# OpenAI — secret; generate in the OpenAI dashboard; never commit a real value here.
OPENAI_API_KEY=
# Non-secret, configurable model name — never hardcoded in application code.
OPENAI_MODEL=

# DeepSeek — secret; generate in the DeepSeek dashboard; never commit a real value here.
DEEPSEEK_API_KEY=
# Non-secret, configurable model name — never hardcoded in application code.
DEEPSEEK_MODEL=

# ─── document-extractor (AI-PDF-SOURCE-01) — reads text-layer PDFs for AI Source Intake ─
# Non-secret. Where the Nuxt server reaches the isolated PDF extractor.
# `docker compose up -d document-extractor-gateway` starts the extractor and its
# loopback gateway. Host-process Nuxt (local development): http://127.0.0.1:8787
# A Nuxt running inside the same Compose project (on document-extractor-internal)
# would use http://document-extractor:8787
# This value is read when the Nuxt config is evaluated; a built server can also be
# pointed elsewhere at runtime with NUXT_DOCUMENT_EXTRACTOR_URL.
# If the extractor is not running, PDFs report "unavailable" and other sources still work.
DOCUMENT_EXTRACTOR_URL=http://127.0.0.1:8787
